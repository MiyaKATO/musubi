{
  "entities": {
    "Link": {
      "title": "Document Link",
      "description": "Represents a link to a document or resource stored in Box, Drive, etc.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "The title of the document"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "The URL to the document"
        },
        "description": {
          "type": "string",
          "description": "Short summary of what is in the document"
        },
        "category": {
          "type": "string",
          "description": "The category of the document"
        },
        "sourceType": {
          "type": "string",
          "enum": ["box", "drive", "local", "other"],
          "description": "The platform where the document is stored"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "createdBy": {
          "type": "string"
        },
        "order": {
          "type": "number",
          "description": "Display order index"
        }
      },
      "required": ["title", "url", "category", "sourceType"]
    },
    "Category": {
      "title": "Document Category",
      "description": "Category for organizing document links",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the category"
        },
        "label": {
          "type": "string",
          "description": "Human-readable label for the category"
        },
        "icon": {
          "type": "string",
          "description": "Icon name from Lucide icon preset"
        },
        "order": {
          "type": "number",
          "description": "Display order sorting index"
        },
        "adminOnly": {
          "type": "boolean",
          "description": "Whether this category is restricted to administrators only"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "label", "icon"]
    },
    "Admin": {
      "title": "Portal Administrator",
      "description": "Registered administrator Google email address",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "description": "Google login email address of the administrator"
        },
        "addedBy": {
          "type": "string",
          "description": "Email or UID of who added this admin"
        },
        "displayName": {
          "type": "string",
          "description": "Optional display name"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["email"]
    }
  },
  "firestore": {
    "links/{linkId}": {
      "schema": "Link",
      "description": "A collection of shared document links"
    },
    "categories/{categoryId}": {
      "schema": "Category",
      "description": "A collection of document categories"
    },
    "admins/{adminId}": {
      "schema": "Admin",
      "description": "A collection of registered portal administrators"
    }
  }
}
