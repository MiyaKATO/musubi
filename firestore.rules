rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null && request.auth.token.email != null && request.auth.token.email.matches('.*@yubisui\\.co\\.jp$');
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isRegisteredAdmin() {
      return isEmailVerified() && (
        request.auth.token.email == 'kato-miya@yubisui.co.jp' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // --- Validation Blueprints ---
    function isValidLink(data) {
      return data.keys().hasAll(['title', 'url', 'category', 'sourceType', 'createdAt', 'updatedAt', 'createdBy'])
        && data.keys().size() >= 7 && data.keys().size() <= 11
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.url is string && data.url.size() > 0 && data.url.size() <= 1000
        && data.category is string && data.category.size() > 0 && data.category.size() <= 100
        && data.sourceType in ['box', 'drive', 'local', 'other']
        && data.createdBy is string && data.createdBy.size() > 0
        && (!('description' in data) || (data.description is string && data.description.size() <= 1000))
        && (!('adminOnly' in data) || data.adminOnly is bool)
        && (!('order' in data) || (data.order is number || data.order is float));
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['id', 'label', 'icon'])
        && data.keys().size() >= 3 && data.keys().size() <= 8
        && data.id is string && data.id.size() > 0 && data.id.size() <= 100
        && data.label is string && data.label.size() > 0 && data.label.size() <= 100
        && data.icon is string && data.icon.size() > 0 && data.icon.size() <= 100
        && (!('adminOnly' in data) || data.adminOnly is bool)
        && (!('order' in data) || (data.order is number || data.order is float));
    }

    function isValidAdmin(data) {
      return data.keys().hasAll(['email'])
        && data.keys().size() >= 1 && data.keys().size() <= 6
        && data.email is string && data.email.size() > 0 && data.email.size() <= 128
        && data.email.matches('.*@yubisui\\.co\\.jp$')
        && (!('addedBy' in data) || (data.addedBy is string && data.addedBy.size() <= 128))
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128));
    }

    // --- Collections ---
    match /categories/{categoryId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn() && isValidId(categoryId);
      allow create, update, delete: if isEmailVerified() && isValidId(categoryId);
    }

    match /links/{linkId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn() && isValidId(linkId);

      allow create: if isEmailVerified() 
        && isValidId(linkId)
        && isValidLink(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isEmailVerified()
        && isValidId(linkId)
        && isValidLink(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'url', 'description', 'category', 'sourceType', 'updatedAt', 'order', 'adminOnly']);

      allow delete: if isEmailVerified();
    }

    match /portal_settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isEmailVerified();
    }
    
    // Admins collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow create: if isEmailVerified() && isValidId(adminId) && isValidAdmin(request.resource.data) && (
        isRegisteredAdmin() || 
        !exists(/databases/$(database)/documents/portal_settings/admin_initialized)
      );
      allow update, delete: if isEmailVerified() && isValidId(adminId) && isRegisteredAdmin();
    }
  }
}
